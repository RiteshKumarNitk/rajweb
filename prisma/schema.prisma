generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & RBAC ───────────────────────────────────────────────

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  OTP_EMAIL
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  passwordHash          String?
  name                  String
  phone                 String?
  avatar                String?
  emailVerified         DateTime?
  isActive              Boolean                  @default(true)
  authProvider          AuthProvider             @default(CREDENTIALS)
  googleId              String?                  @unique
  lastLoginAt           DateTime?
  isFederationWide      Boolean                  @default(false)
  // Organisational scope (see src/security/rbac/org-scope.ts):
  //   super-admin / isFederationWide -> GLOBAL
  //   districtId set                 -> DISTRICT (state inherited from the district)
  //   stateId set (no district)      -> STATE
  //   neither                        -> no data access
  stateId               String?
  state                 State?                   @relation(fields: [stateId], references: [id])
  roleId                String
  role                  Role                     @relation(fields: [roleId], references: [id])
  districtId            String?
  district              District?                @relation(fields: [districtId], references: [id])
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  profile               UserProfile?
  player                Player?
  coach                 Coach?
  clubMembership        ClubMembership?
  schoolMembership      SchoolMembership?
  academyMembership     AcademyMembership?
  requests              Request[]
  equipmentOrders       EquipmentPurchaseOrder[]
  equipmentRequirements EquipmentRequirement[]   @relation("RequirementRequestedBy")
  reviewedRequirements  EquipmentRequirement[]   @relation("RequirementReviewedBy")
  mediaAssets           MediaAsset[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([roleId])
  @@index([districtId])
  @@index([stateId])
  @@map("users")
}

model UserProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth  DateTime?
  gender       Gender?
  address      String?
  city         String?
  state        String?
  country      String?     @default("India")
  pincode      String?
  // Member home State/District, set once at onboarding (later moves go through
  // the district-change request). Drives the member equipment catalog. Separate
  // from User.stateId/districtId, which are ADMIN scope.
  stateId      String?
  homeState    State?      @relation("MemberHomeState", fields: [stateId], references: [id])
  districtId   String?
  homeDistrict District?   @relation("MemberHomeDistrict", fields: [districtId], references: [id])
  memberType   MemberType?
  onboardedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([districtId])
  @@map("user_profiles")
}

enum MemberType {
  PLAYER
  COACH
  SUPPORTER
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("email_otps")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── States & Districts ────────────────────────────────────────
// Hierarchy: State -> District -> Players / Coaches / Memberships.
// Player, Coach and membership records inherit their State through
// `districtId -> District.stateId`; they deliberately carry no stateId of
// their own so ownership can never disagree with the district.

model State {
  id                    String                   @id @default(cuid())
  name                  String                   @unique
  slug                  String                   @unique
  code                  String?                  @unique
  isActive              Boolean                  @default(true)
  sortOrder             Int                      @default(0)
  districts             District[]
  users                 User[]
  tournaments           Tournament[]
  equipmentItems        EquipmentItem[]
  equipmentOrders       EquipmentPurchaseOrder[]
  signatories           CertificateSignatory[]
  memberProfiles        UserProfile[]            @relation("MemberHomeState")
  equipmentRequirements EquipmentRequirement[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([isActive, sortOrder])
  @@map("states")
}

model District {
  id                    String                   @id @default(cuid())
  name                  String
  slug                  String
  // Nullable only so pre-existing rows survive the schema change; the seed
  // backfills them. A district with no state is visible to Super Admin only.
  stateId               String?
  state                 State?                   @relation(fields: [stateId], references: [id])
  sortOrder             Int                      @default(0)
  president             String?
  secretary             String?
  email                 String?
  phone                 String?
  address               String?
  isActive              Boolean                  @default(true)
  users                 User[]
  players               Player[]
  coaches               Coach[]
  clubMemberships       ClubMembership[]
  schoolMemberships     SchoolMembership[]
  academyMemberships    AcademyMembership[]
  tournaments           Tournament[]
  requestedByRequests   Request[]                @relation("RequestedDistrict")
  equipmentItems        EquipmentItem[]
  equipmentOrders       EquipmentPurchaseOrder[]
  signatories           CertificateSignatory[]
  memberProfiles        UserProfile[]            @relation("MemberHomeDistrict")
  equipmentRequirements EquipmentRequirement[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  // Names/slugs are unique within a state, not globally.
  @@unique([stateId, name])
  @@unique([stateId, slug])
  @@index([stateId, sortOrder])
  @@map("districts")
}

// ─── Players ───────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Player {
  id                      String                   @id @default(cuid())
  playerId                String                   @unique
  name                    String
  dateOfBirth             DateTime
  gender                  Gender
  email                   String
  mobile                  String
  photo                   String?
  districtId              String
  district                District                 @relation(fields: [districtId], references: [id])
  userId                  String?                  @unique
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  state                   String                   @default("Rajasthan")
  category                String?
  // Government ID — collected on account applications. The document is a
  // private MediaAsset served only to the owner and in-scope reviewers.
  governmentIdType        GovernmentIdType?
  governmentIdNumber      String?
  governmentIdDocumentId  String?
  governmentIdDocument    MediaAsset?              @relation("PlayerGovernmentId", fields: [governmentIdDocumentId], references: [id], onDelete: SetNull)
  status                  ApprovalStatus           @default(PENDING)
  approvedAt              DateTime?
  approvedBy              String?
  rejectionReason         String?
  expiresAt               DateTime?
  certificates            PlayerCertificate[]
  tournamentRegistrations TournamentRegistration[]
  requests                Request[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([districtId])
  @@index([status])
  @@map("players")
}

// Two kinds share this table:
//  - registration certificate: tournamentId = null (one active per player);
//  - tournament certificate:   tournamentId set (one per player per tournament).
// Scope: a tournament certificate belongs to its tournament's state/district;
// a registration certificate follows the player's district -> state.
// Everything printed on the certificate is snapshotted at issue time so a
// later rename/re-designation never changes an issued certificate.
model PlayerCertificate {
  id                String      @id @default(cuid())
  certificateNumber String      @unique
  playerId          String
  player            Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournamentId      String?
  tournament        Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  qrCode            String      @unique
  issuedAt          DateTime    @default(now())
  expiresAt         DateTime?
  pdfPath           String?
  isRevoked         Boolean     @default(false)
  revokedAt         DateTime?
  revokedReason     String?
  // Issue-time snapshots (null on certificates issued before these existed).
  title             String?
  eventName         String?
  eventStartDate    DateTime?
  eventEndDate      DateTime?
  venue             String?
  districtName      String?
  stateName         String?
  position          String?
  logoUrl           String?
  // [{ name, designation, organization, signatureImageUrl }] in signing order.
  signatories       Json?
  // Recipient as printed ("Player ID: …" line included), so a later rename
  // never changes an issued certificate. Null on rows issued before it existed.
  recipientName     String?
  recipientIdLine   String?
  issuedById        String?

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@index([tournamentId])
  @@map("player_certificates")
}

// ─── Coaches ───────────────────────────────────────────────────

enum CertificationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  INTERNATIONAL
}

model Coach {
  id                     String             @id @default(cuid())
  coachId                String             @unique
  name                   String
  email                  String
  mobile                 String
  photo                  String?
  qualification          String
  certificationLevel     CertificationLevel
  districtId             String
  district               District           @relation(fields: [districtId], references: [id])
  userId                 String?            @unique
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Government ID — see Player.
  governmentIdType       GovernmentIdType?
  governmentIdNumber     String?
  governmentIdDocumentId String?
  governmentIdDocument   MediaAsset?        @relation("CoachGovernmentId", fields: [governmentIdDocumentId], references: [id], onDelete: SetNull)
  status                 ApprovalStatus     @default(PENDING)
  approvedAt             DateTime?
  approvedBy             String?
  rejectionReason        String?
  expiresAt              DateTime?
  certificates           CoachCertificate[]
  requests               Request[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([districtId])
  @@index([status])
  @@map("coaches")
}

model CoachCertificate {
  id                String    @id @default(cuid())
  certificateNumber String    @unique
  coachId           String
  coach             Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  qrCode            String    @unique
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime?
  pdfPath           String?
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  revokedReason     String?

  @@index([coachId])
  @@map("coach_certificates")
}

// ─── Memberships ───────────────────────────────────────────────

enum MembershipType {
  CLUB
  SCHOOL
  ACADEMY
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  SUSPENDED
}

model ClubMembership {
  id              String           @id @default(cuid())
  membershipId    String           @unique
  clubName        String
  contactPerson   String
  email           String
  mobile          String
  address         String
  districtId      String
  district        District         @relation(fields: [districtId], references: [id])
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  numberOfCourts  Int              @default(1)
  facilities      String?
  status          MembershipStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  expiresAt       DateTime?
  certificatePath String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([districtId])
  @@index([status])
  @@map("club_memberships")
}

model SchoolMembership {
  id              String           @id @default(cuid())
  membershipId    String           @unique
  schoolName      String
  principalName   String
  email           String
  mobile          String
  address         String
  districtId      String
  district        District         @relation(fields: [districtId], references: [id])
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentCount    Int?
  status          MembershipStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  expiresAt       DateTime?
  certificatePath String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([districtId])
  @@index([status])
  @@map("school_memberships")
}

model AcademyMembership {
  id              String           @id @default(cuid())
  membershipId    String           @unique
  academyName     String
  directorName    String
  email           String
  mobile          String
  address         String
  districtId      String
  district        District         @relation(fields: [districtId], references: [id])
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  coachCount      Int?
  status          MembershipStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  expiresAt       DateTime?
  certificatePath String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([districtId])
  @@index([status])
  @@map("academy_memberships")
}

// ─── Player/Coach Requests ─────────────────────────────────────
// Distinct from Player/Coach registration: a Request is raised by an
// already-registered Player or Coach asking RRA to change or act on
// something about their existing record. One generic table (not five) —
// unlike Applications, every request type shares the same shape
// (type/status/reason/resolution), so a per-type table would just be
// column-for-column duplication.

enum RequestType {
  PROFILE_CORRECTION
  CONTACT_UPDATE
  ADDRESS_UPDATE
  DISTRICT_CHANGE
  CERTIFICATE_REQUEST
  CERTIFICATE_CORRECTION
  DOCUMENT_UPDATE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Withdrawn by the member who made it, before any admin decision.
  CANCELLED
}

model Request {
  id                  String        @id @default(cuid())
  requestNumber       String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId            String?
  player              Player?       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coachId             String?
  coach               Coach?        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  type                RequestType
  status              RequestStatus @default(PENDING)
  reason              String
  // Freeform "before/after" pair, used by request types with no dedicated
  // structured field below (PROFILE_CORRECTION, CERTIFICATE_*, DOCUMENT_UPDATE, OTHER).
  currentValue        String?
  requestedValue      String?
  // PROFILE_CORRECTION of one known field (NAME, DATE_OF_BIRTH, GENDER,
  // CATEGORY): applied on approval. Null = free-text, informational only.
  requestedField      String?
  // Structured fields for the request types whose approval can safely apply
  // itself to the underlying record — see request.service.ts for exactly
  // which types are auto-applied vs. informational-only.
  requestedMobile     String?
  requestedEmail      String?
  requestedAddress    String?
  requestedDistrictId String?
  requestedDistrict   District?     @relation("RequestedDistrict", fields: [requestedDistrictId], references: [id])
  adminRemarks        String?
  rejectionReason     String?
  resolvedAt          DateTime?
  resolvedBy          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([playerId])
  @@index([coachId])
  @@index([status])
  @@map("requests")
}

// ─── Tournaments ───────────────────────────────────────────────

enum TournamentCategory {
  JUNIOR
  SENIOR
  OPEN
  PROFESSIONAL
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tournament {
  id                     String                           @id @default(cuid())
  name                   String
  slug                   String                           @unique
  description            String?
  category               TournamentCategory
  status                 TournamentStatus                 @default(DRAFT)
  // Owning state. Always set for new tournaments; for district tournaments
  // it must equal district.stateId. A tournament with no district is
  // state-wide for this state.
  stateId                String?
  state                  State?                           @relation(fields: [stateId], references: [id])
  districtId             String?
  district               District?                        @relation(fields: [districtId], references: [id])
  venue                  String?
  city                   String?
  startDate              DateTime
  endDate                DateTime
  registrationStart      DateTime?
  registrationDeadline   DateTime?
  maxParticipants        Int?
  // Google Drive poster link, per the client's approved requirement — not a
  // file upload. Reuses the pre-existing (previously unused) `banner` column
  // rather than adding a second field for the same concept.
  banner                 String?
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  requiresApprovedPlayer Boolean                          @default(true)
  // Tournament-specific certificate settings (certificates snapshot them).
  certificateTitle       String?
  certificateLogoUrl     String?
  signatories            TournamentSignatory[]
  certificates           PlayerCertificate[]
  registrationCategories TournamentRegistrationCategory[]
  registrations          TournamentRegistration[]
  fixtures               Fixture[]
  matches                Match[]
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@index([status])
  @@index([districtId])
  @@index([stateId])
  @@map("tournaments")
}

enum TournamentEventType {
  SINGLES
  DOUBLES
}

// Configurable, per-tournament registration option (e.g. "Junior Singles",
// "Senior Doubles") with its own fee — independent from Tournament.category,
// which is a single whole-tournament classification (Open/Junior/Senior/Pro)
// unrelated to which purchasable event types a player can register for.
model TournamentRegistrationCategory {
  id            String                   @id @default(cuid())
  tournamentId  String
  tournament    Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name          String
  type          TournamentEventType
  fee           Int
  isActive      Boolean                  @default(true)
  registrations TournamentRegistration[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([tournamentId])
  @@map("tournament_registration_categories")
}

model TournamentRegistration {
  id           String                          @id @default(cuid())
  tournamentId String
  tournament   Tournament                      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player                          @relation(fields: [playerId], references: [id])
  categoryId   String?
  category     TournamentRegistrationCategory? @relation(fields: [categoryId], references: [id])
  // Snapshot of the category fee at the moment of registration — Phase I
  // must write this once and never recompute it from the category's current
  // fee, so a later Super Admin price change never alters a past registration.
  amount       Int?
  seed         Int?
  status       ApprovalStatus                  @default(PENDING)
  registeredAt DateTime                        @default(now())

  @@unique([tournamentId, playerId])
  @@map("tournament_registrations")
}

model Fixture {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  roundName    String
  matchNumber  Int
  player1Id    String?
  player2Id    String?
  winnerId     String?
  scheduledAt  DateTime?
  match        Match?

  @@index([tournamentId])
  @@map("fixtures")
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fixtureId    String     @unique
  fixture      Fixture    @relation(fields: [fixtureId], references: [id])
  player1Score Int?
  player2Score Int?
  winnerId     String?
  status       String     @default("scheduled")
  playedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tournamentId])
  @@map("matches")
}

// ─── Media CMS ─────────────────────────────────────────────────

model News {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  coverImage      String?
  author          String?
  category        String?
  tags            String[]
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
  @@map("news")
}

model Video {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  url         String
  thumbnail   String?
  category    String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
  @@map("videos")
}

model Gallery {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  category    String?
  // Public page item image. Existing seeded galleries use static /images/...
  // paths; nothing uploads files here (public image URLs would need
  // next.config remotePatterns). Certificate PDFs go through StorageAdapter,
  // which is unrelated to gallery imagery.
  imageUrl    String?
  // Optional external Google Drive gallery link opened from the item modal.
  // Stored as-is; never fetched or proxied server-side.
  driveUrl    String?
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(false)
  publishedAt DateTime?
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
  @@map("galleries")
}

model GalleryImage {
  id        String  @id @default(cuid())
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  alt       String?
  order     Int     @default(0)

  @@index([galleryId])
  @@map("gallery_images")
}

// ─── Donations ─────────────────────────────────────────────────

model Donation {
  id          String   @id @default(cuid())
  name        String
  email       String?
  mobile      String?
  amount      Float
  message     String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("donations")
}

// ─── Contact ───────────────────────────────────────────────────

enum ContactStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  // Inbox lifecycle for the admin contact inbox. isRead kept for backward
  // compatibility with any historical readers; new rows derive it from status.
  status    ContactStatus @default(NEW)
  isRead    Boolean       @default(false)
  // Whether the Super Admin notification email was dispatched (visitor
  // confirmation is separate and best-effort).
  emailSent Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@map("contact_messages")
}

// ─── Equipment shop ───────────────────────────────────────────

enum EquipmentCategory {
  RACQUETS
  BALLS
  GRIPS
  BAGS
  ACCESSORIES
  TRAINING
  OTHER
}

// Stock is never permanently deducted at purchase time — it is reserved
// atomically when an order is created (conditional decrement, guarded against
// going negative) and only permanently consumed when the payment is verified
// server-side. Cancelled/failed orders release their reservation.
model EquipmentItem {
  id               String                       @id @default(cuid())
  name             String
  slug             String                       @unique
  description      String?
  shortDescription String?
  image            String?
  sku              String?
  // Free-form "Label: value" lines shown on the product page.
  specifications   String?
  category         EquipmentCategory            @default(OTHER)
  // Whole rupees — integer money, no floats.
  price            Int
  stockQuantity    Int                          @default(0)
  isActive         Boolean                      @default(true)
  sortOrder        Int                          @default(0)
  // Owning inventory: districtId set = that district's stock (stateId = its
  // state); stateId only = state-level stock; both null = RRA central store
  // (Super Admin only). Items created before ownership existed are central.
  stateId          String?
  state            State?                       @relation(fields: [stateId], references: [id])
  districtId       String?
  district         District?                    @relation(fields: [districtId], references: [id])
  purchaseItems    EquipmentPurchaseOrderItem[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
  @@index([stateId])
  @@index([districtId])
  @@map("equipment_items")
}

// Fulfilment lifecycle. New orders: PENDING_PAYMENT -> (verified payment) ->
// PLACED -> CONFIRMED -> PROCESSING -> SHIPPED -> DELIVERED, or CANCELLED while
// unpaid. PAID and COMPLETED are legacy values kept for existing rows (read as
// PLACED and DELIVERED).
enum PurchaseStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  COMPLETED
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// An authenticated member's equipment purchase. Amounts are whole-rupee
// integers. Item rows snapshot name + unit price at purchase time; later
// price changes never affect existing orders.
model EquipmentPurchaseOrder {
  id                   String                       @id @default(cuid())
  orderNumber          String                       @unique
  userId               String
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               PurchaseStatus               @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus                @default(PENDING)
  subtotal             Int
  total                Int
  // Seller scope snapshot, copied from the items' inventory at order time
  // (every line of one order comes from the same inventory). Kept even if
  // the item is later moved, so historical orders never change hands.
  stateId              String?
  state                State?                       @relation(fields: [stateId], references: [id])
  districtId           String?
  district             District?                    @relation(fields: [districtId], references: [id])
  // Buyer / delivery snapshot taken at order time (null on legacy orders).
  buyerName            String?
  buyerEmail           String?
  buyerPhone           String?
  buyerMemberId        String?
  deliveryAddress      String?
  deliveryCity         String?
  deliveryPincode      String?
  deliveryStateName    String?
  deliveryDistrictName String?
  // Fulfilment timeline.
  paidAt               DateTime?
  confirmedAt          DateTime?
  processingAt         DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  courierName          String?
  trackingNumber       String?
  items                EquipmentPurchaseOrderItem[]
  payments             EquipmentPayment[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stateId])
  @@index([districtId])
  @@map("equipment_purchase_orders")
}

model EquipmentPurchaseOrderItem {
  id                  String                 @id @default(cuid())
  orderId             String
  order               EquipmentPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipmentId         String
  equipment           EquipmentItem          @relation(fields: [equipmentId], references: [id])
  productNameSnapshot String
  skuSnapshot         String?
  // Snapshot of EquipmentItem.price (whole rupees) at purchase time — never
  // recomputed from the product's current price.
  unitPriceSnapshot   Int
  quantity            Int
  lineTotal           Int

  @@index([orderId])
  @@index([equipmentId])
  @@map("equipment_purchase_order_items")
}

// ─── Media videos (YouTube) ───────────────────────────────────

// Public Media → Videos listing. The legacy `Video` model (seed-only, unused
// by any route) is intentionally left untouched; this model is the managed,
// YouTube-specific listing.
model MediaVideo {
  id             String   @id @default(cuid())
  title          String
  description    String?
  // Normalized 11-character YouTube video ID extracted server-side.
  youtubeVideoId String   @unique
  // Original URL as entered by the admin (watch/youtu.be/shorts forms).
  youtubeUrl     String
  category       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("media_videos")
}

model EquipmentOrder {
  id        String   @id @default(cuid())
  name      String
  mobile    String
  address   String
  district  String
  equipment String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("equipment_orders")
}

// ─── Website Content ───────────────────────────────────────────

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  content   String
  metadata  Json?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("website_content")
}

model ExecutiveMember {
  id          String   @id @default(cuid())
  name        String
  designation String
  photo       String?
  bio         String?
  email       String?
  phone       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("executive_members")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  type      String   @default("sponsor")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("partners")
}

// ─── Audit & Settings ──────────────────────────────────────────

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  DOWNLOAD
  APPROVE
  REJECT
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  module     String
  entityId   String?
  entityType String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── Certificate signatories ─────────────────────────────────────
// Officials who sign certificates. Owned by a scope like other records:
// districtId set = district official (stateId = its state); stateId only =
// state official; both null = federation-level. A tournament picks its own
// signatories (TournamentSignatory, ordered); issued certificates snapshot
// name/designation, so later edits never alter issued certificates.
model CertificateSignatory {
  id                String                @id @default(cuid())
  name              String
  designation       String
  organization      String?
  signatureImageUrl String?
  stateId           String?
  state             State?                @relation(fields: [stateId], references: [id])
  districtId        String?
  district          District?             @relation(fields: [districtId], references: [id])
  isActive          Boolean               @default(true)
  sortOrder         Int                   @default(0)
  tournaments       TournamentSignatory[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([stateId])
  @@index([districtId])
  @@map("certificate_signatories")
}

model TournamentSignatory {
  tournamentId String
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  signatoryId  String
  signatory    CertificateSignatory @relation(fields: [signatoryId], references: [id], onDelete: Cascade)
  sortOrder    Int                  @default(0)

  @@id([tournamentId, signatoryId])
  @@index([signatoryId])
  @@map("tournament_signatories")
}

// One payment attempt for an equipment order. Today the only provider is the
// dummy Razorpay-style test gateway (isTest = true, no real money); the row
// shape matches what a real gateway integration needs.
model EquipmentPayment {
  id                String                 @id @default(cuid())
  orderId           String
  order             EquipmentPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  isTest            Boolean                @default(true)
  providerOrderId   String                 @unique
  providerPaymentId String?                @unique
  amount            Int
  currency          String                 @default("INR")
  status            PaymentAttemptStatus   @default(CREATED)
  failureReason     String?
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([orderId])
  @@map("equipment_payments")
}

enum PaymentAttemptStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

// Equipment requirement raised for one district (by its admin, or by the
// State/Super Admin on its behalf) and reviewed by the State Admin or Super Admin.
model EquipmentRequirement {
  id                 String              @id @default(cuid())
  requirementNumber  String              @unique
  stateId            String
  state              State               @relation(fields: [stateId], references: [id])
  districtId         String
  district           District            @relation(fields: [districtId], references: [id])
  requestedById      String
  requestedBy        User                @relation("RequirementRequestedBy", fields: [requestedById], references: [id])
  itemName           String
  category           EquipmentCategory   @default(OTHER)
  description        String?
  quantity           Int
  // Whole rupees, optional estimate.
  estimatedUnitPrice Int?
  priority           RequirementPriority @default(MEDIUM)
  notes              String?
  attachmentId       String?
  requiredBy         DateTime?
  status             RequirementStatus   @default(PENDING)
  reviewNote         String?
  reviewedById       String?
  reviewedBy         User?               @relation("RequirementReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([stateId])
  @@index([districtId])
  @@index([status])
  @@map("equipment_requirements")
}

enum RequirementStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FULFILLED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Uploaded files kept in the database (works on serverless hosts without a
// file store). Equipment images are public; requirement attachments are
// served only to admins in the owning district scope; government ID documents
// only to their uploader and to Player/Coach reviewers in the district scope.
model MediaAsset {
  id                  String         @id @default(cuid())
  kind                MediaAssetKind
  mimeType            String
  size                Int
  fileName            String?
  data                Bytes
  stateId             String?
  districtId          String?
  uploadedById        String?
  uploadedBy          User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  playerGovernmentIds Player[]       @relation("PlayerGovernmentId")
  coachGovernmentIds  Coach[]        @relation("CoachGovernmentId")

  @@index([kind])
  @@map("media_assets")
}

enum MediaAssetKind {
  EQUIPMENT_IMAGE
  REQUIREMENT_ATTACHMENT
  GOVERNMENT_ID
}

enum GovernmentIdType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENCE
}

// Files kept in the database by the "database" storage adapter (used on
// hosts without a persistent disk, e.g. Vercel). Keyed by the same path the
// other adapters use; served only through the authorization-checked /api/files.
model StoredFile {
  path      String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("stored_files")
}
